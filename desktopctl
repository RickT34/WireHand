#!/bin/bash
set -euo pipefail
root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
config="$root/deploy/docker-desktop/.env"
compose=(docker compose --env-file "$config" -f "$root/deploy/docker-desktop/compose.yaml")
command=${1:-help}
if (( $# )); then shift; fi
case "$command" in
    init)
        if [ -e "$config" ]; then
            echo "Existing configuration preserved: $config"
        else
            python3 - "$config" <<'PY'
import os, secrets, sys
with os.fdopen(os.open(sys.argv[1], os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600), 'w') as f:
    f.write(f'KVM_TOKEN={secrets.token_urlsafe(32)}\n'
            'KVM_DESKTOP_BIND=127.0.0.1\nKVM_DESKTOP_PORT=18810\n'
            'KVM_HOSTS=localhost,127.0.0.1\nKVM_DESKTOP_RESOLUTION=1280x800\n')
PY
            echo "Created private configuration: $config"
        fi
        ;;
    build|up|down|restart|status|logs|mcp|shell)
        if [ ! -f "$config" ]; then
            echo 'Run ./desktopctl init first' >&2
            exit 1
        fi
        case "$command" in
            build) exec "${compose[@]}" build desktop ;;
            up) exec "${compose[@]}" up -d --build --wait desktop ;;
            down) exec "${compose[@]}" down ;;
            restart) exec "${compose[@]}" restart desktop ;;
            status) exec "${compose[@]}" ps ;;
            logs) exec "${compose[@]}" logs --tail=100 -f desktop ;;
            mcp) exec "${compose[@]}" exec -T --user agent desktop kvm-mcp ;;
            shell) exec "${compose[@]}" exec --user agent desktop bash "$@" ;;
        esac
        ;;
    *)
        echo 'Usage: ./desktopctl {init|build|up|down|restart|status|logs|mcp|shell}'
        ;;
esac
