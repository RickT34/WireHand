# Copy to /etc/kvm-mcp.env and supply your own secret (at least 20 characters).
KVM_TOKEN=
KVM_HOSTS=192.168.50.152,r5p,localhost,127.0.0.1
KVM_BIND=0.0.0.0
KVM_PORT=8080
KVM_VIDEO_MODE=hardware
KVM_TRANSPORT=h264
KVM_MAX_FPS=60
KVM_MAX_WIDTH=1280
KVM_MAX_HEIGHT=720
KVM_H264_BITRATE=2500000
KVM_RECORDINGS=/var/lib/kvm-mcp/recordings
# Nginx on this host: bind to loopback and add the public domain to KVM_HOSTS.
# KVM_BIND=127.0.0.1
# KVM_TRUSTED_PROXIES=127.0.0.1
